import java.io.*;
import java.util.*;

// Design a time-based key-value data structure that can store multiple values for the same key at different time stamps and retrieve the key's value at a certain timestamp.

// Implement the TimeMap class:

// TimeMap() Initializes the object of the data structure.
// void set(String key, String value, int timestamp) Stores the key key with the value value at the given time timestamp.
// String get(String key, int timestamp) Returns a value such that set was called previously, with timestamp_prev <= timestamp. If there are multiple such values, it returns the value associated with the largest timestamp_prev. If there are no values, it returns "".


// foo
//   bar  1
//   bar2 4


//   foo , 0 - ""
//   foo, 2 - 4

// obj{
//   Map<Integer, String>
//   ArrayList<Integer>
// }

// Map<String, obj> - O(1)
// Map<String, > -  {1, 4} - o(log n)
//
// Input
// ["TimeMap", "set", "get", "get", "set", "get", "get"]
// [[], ["foo", "bar", 1], ["foo", 1], ["foo", 3], ["foo", "bar2", 4], ["foo", 4], ["foo", 5]]
// Output
// [null, null, "bar", "bar", null, "bar2", "bar2"]

// Explanation
// TimeMap timeMap = new TimeMap();
// timeMap.set("foo", "bar", 1);  // store the key "foo" and value "bar" along with timestamp = 1.
// timeMap.get("foo", 1);         // return "bar"
// timeMap.get("foo", 3);         // return "bar", since there is no value corresponding to foo at timestamp 3 and timestamp 2, then the only value is at timestamp 1 is "bar".
// timeMap.set("foo", "bar2", 4); // store the key "foo" and value "bar2" along with timestamp = 4.
// timeMap.get("foo", 4);         // return "bar2"
// timeMap.get("foo", 5);         // return "bar2"


class Solution {

  public static void main(String[] args) {

    TimeMap map = new TimeMap();
    map.set("foo", "bar", 1);
    //map.print("foo");
    System.out.println(map.get("foo", 1));
    System.out.println(map.get("foo", 3));
    map.set("foo", "bar2", 4);
    System.out.println(map.get("foo", 4));
    System.out.println(map.get("foo", 5));
  }
}


class TimeMap {

  Map<String, TimeLookupObject> series;

  public TimeMap() {
    series = new HashMap<>();
  }

  public void print(String key) {
    series.get(key).print();
  }

  public void set(String key, String value, int timestamp) {
      if (series.containsKey(key)) {
        TimeLookupObject obj = series.get(key);
        obj.add(timestamp, value);
        series.put(key, obj);
      } else {
        TimeLookupObject obj = new TimeLookupObject();
        obj.add(timestamp, value);
        series.put(key, obj);
      }
  }

  public String get(String key, int timestamp) {
    List<Integer> time = series.get(key).time;

    int l = 0;
    int r = time.size() - 1;

    while(l < r) {
      int mid = l + (r - l)/2;
      if (time.get(mid) == timestamp) return series.get(key).data.get(time.get(mid));
      else if (time.get(mid) > timestamp) r = mid - 1;
      else l = mid + 1;
    }
    if (time.get(l) > timestamp) return null;
    else if(timestamp < time.get(r)) series.get(key).data.get(time.get(l));
    return series.get(key).data.get(time.get(r));
  }

//space

  class TimeLookupObject {
    Map<Integer, String> data;
    List<Integer> time;
    TimeLookupObject() {
      this.data = new HashMap<>();
      this.time = new ArrayList<>();
    }

    void add(int timestamp, String value) {
      this.time.add(timestamp);
      data.put(timestamp, value);
    }

    void print() {
      System.out.println(data);
      System.out.println("time : ");
      System.out.println(time);
    }

  }

}






